{
  "cli": {
    "version": ">= 16.20.1",
    "appVersionSource": "remote"  
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"  
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"  
      },
      "channel": "preview" 
    },
    "production": {
      "autoIncrement": true,  
      "ios": {
        "resourceClass": "m-medium",  
        "buildConfiguration": "Release"
      },
      "channel": "production"  
    }
  },
  "submit": {
    "production": {}
  }
}